(Optimised Query: ) Tj
T* (-- Query 1: Active users with last order date and total spent) Tj
T* (WITH user_orders AS \() Tj
T* (  SELECT) Tj
T* (    o.user_id,) Tj
T* (    MAX\(o.created_at\) AS last_order_date) Tj
T* (  FROM orders o) Tj
T* (  GROUP BY o.user_id) Tj
T* (\),) Tj
T* (user_spend AS \() Tj
T* (  SELECT) Tj
T* (    o.user_id,) Tj
T* (    SUM\(oi.quantity * oi.unit_price\) AS total_spent) Tj
T* (  FROM orders o) Tj
T* (  JOIN order_items oi ON oi.order_id = o.id) Tj
T* (  GROUP BY o.user_id) Tj
