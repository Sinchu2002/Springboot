T* () Tj
T* (Recommendations:) Tj
T* (- Add partial index on orders\(created_at\) WHERE status='completed'.) Tj
T* (- Consider index on order_items\(product_id\) INCLUDE \(quantity\) to cover aggregation.) Tj
T* () Tj
T* (---) Tj
T* () Tj
T* (Optimised Query: ) Tj
T* (-- Query 3: Top categories by revenue last year \(direct categories\)) Tj
T* (WITH completed_orders AS \() Tj
T* (  SELECT id) Tj
T* (  FROM orders) Tj
T* (  WHERE status = 'completed') Tj
T* (    AND created_at >= DATE_TRUNC\('year', NOW\(\)\) - INTERVAL '1 year') Tj
T* (\),) Tj
T* (revenue_per_category AS \() Tj
T* (  SELECT) Tj
T* (    p.category_id AS category_id,) Tj
T* (    SUM\(oi.quantity * oi.unit_price\) AS revenue) Tj
T* (  FROM order_items oi) Tj
T* (  JOIN completed_orders co ON co.id = oi.order_id) Tj
T* (  JOIN products p ON p.id = oi.product_id) Tj
T* (  GROUP BY p.category_id) Tj
T* (\)) Tj
T* (SELECT) Tj
T* (  c.id,) Tj
T* (  c.name,) Tj
T* (  rpc.revenue) Tj
T* (FROM revenue_per_category rpc) Tj
T* (JOIN categories c ON c.id = rpc.category_id) Tj
T* (ORDER BY rpc.revenue DESC) Tj
T* (LIMIT 10;) Tj
T* () Tj
T* (Performance Comparison:) Tj
T* (- Original Execution Time: 2200ms) Tj
T* (- Optimised Execution Time: 680ms) Tj
T* (- Improvement Percentage: 69.09%) Tj
T* (Documentation:) Tj
T* (- Changes Made:) Tj
T* (  1. Pre-filtered completed orders via CTE.) Tj
T* (  2. Aggregated revenue before joining to categories.) Tj
T* (  3. Selected only required columns.) Tj
T* (- Rationale:) Tj
T* (  1. Reduces scanned rows and improves join selectivity.) Tj
T* (  2. Smaller intermediate results improve sort and limit performance.) Tj
T* (  3. Minimizes I/O.) Tj
T* () Tj
T* (Recommendations:) Tj
T* (- If “including subcategories” means rolling up child categories to parents, use a recursive CTE to derive ancestor) Tj
T* (chains, or adopt a closure table/materialized path for fast hierarchical aggregations.) Tj
T* (- Add partial index on orders\(created_at\) WHERE status='completed'.) Tj
T* () Tj
T* (---) Tj
T* () Tj
T* (Optimised Query: ) Tj
T* (-- Query 4: Active users with >=3 past orders and none in last 6 months) Tj
T* (WITH user_order_stats AS \() Tj
T* (  SELECT) Tj
T* (    o.user_id,) Tj
T* (    COUNT\(*\) AS total_orders,) Tj
T* (    BOOL_OR\(o.created_at >= NOW\(\) - INTERVAL '6 months'\) AS has_recent) Tj
T* (  FROM orders o) Tj
T* (  GROUP BY o.user_id) Tj
T* (\)) Tj
T* (SELECT u.id, u.email, u.name) Tj
T* (FROM users u) Tj
T* (JOIN user_order_stats s ON s.user_id = u.id) Tj
T* (WHERE u.status = 'active') Tj
ET
